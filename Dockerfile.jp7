# syntax=docker/dockerfile:1.6
# ==============================================================================
# Advantech YOLO Vision Application — JetPack 7 / Jetson Thor Demo Image
# Base: WEDA-CV Platform (Thor)
# ==============================================================================
# Modelled on Application_Demo_Container_Project/CV_demo (Object-counting /
# Instance-Segmentation), which are the validated Thor demos.
#
# Two things differ from the JP6 image (Dockerfile) beyond the base:
#
#  1. Ultralytics is NOT baked in. It is BYOL (bring-your-own-licence) and is
#     installed at runtime by entrypoint.jp7.sh into a named volume, gated on
#     ACCEPT_ULTRALYTICS_EULA. Baking it into the image would ship a licensed
#     component we are not entitled to redistribute.
#  2. No opencv swap. The weda-cv base already ships a GUI-capable, Thor-built
#     OpenCV; reinstalling the x86-style opencv-python wheel over it is how you
#     lose CUDA/NVMM support on this platform.
#
# ONE DOCKERFILE, THREE PURPOSE-BUILT IMAGES. Each image carries only the
# weights for its own task and defaults to running it:
#
#   docker build -f Dockerfile.jp7 --build-arg YOLO_TASK=detect \
#     --build-arg YOLO_WEIGHTS=yolo11n.pt \
#     -t harbor.edgesync.cloud/weda-ai/advantech-yolo-vision:jp7-detect .
#   docker build -f Dockerfile.jp7 --build-arg YOLO_TASK=segment \
#     --build-arg YOLO_WEIGHTS=yolo11n-seg.pt \
#     -t harbor.edgesync.cloud/weda-ai/advantech-yolo-vision:jp7-segment .
#   docker build -f Dockerfile.jp7 --build-arg YOLO_TASK=classify \
#     --build-arg YOLO_WEIGHTS=yolo11n-cls.pt \
#     -t harbor.edgesync.cloud/weda-ai/advantech-yolo-vision:jp7-classify .
#
# Or all three at once: ./build.jp7.sh --task all
#
# It is a single parameterised Dockerfile rather than three near-identical
# copies (the JP6 Dockerfile/.segment/.classify trio) for two reasons. One,
# three copies drift -- the JP6 set already has. Two, and more important, EVERY
# INSTRUCTION BEFORE THE WEIGHTS IS BYTE-IDENTICAL ACROSS THE THREE BUILDS, so
# all the expensive layers (the 12 GB base, apt, demo video, sources) resolve to
# the same digests and are stored ONCE in harbor and once on the device. The
# three images cost ~12 GB in total, not ~36 GB. Reordering anything below the
# divergence marker into the common section, or vice versa, silently breaks
# that sharing.
#
# Run: use build.jp7.sh — it detects X11 and waits out first-run hydration.
# ==============================================================================
FROM harbor.edgesync.cloud/weda-ai/weda-cv:1.0.0-thor

LABEL maintainer="Kevin.Chien" \
      vendor="Advantech" \
      org.opencontainers.image.title="Advantech YOLO Vision — JP7 Demo" \
      org.opencontainers.image.description="YOLO11 detect/segment/classify on Jetson Thor (JetPack 7)" \
      com.advantech.layer="demo" \
      com.advantech.type="application" \
      com.advantech.base="weda-cv:1.0.0-thor" \
      com.advantech.target="jetson-thor"

WORKDIR /wise-edge/advantech-yolo

# Thor builder resources link against /usr/local/lib; without this TensorRT
# engine build fails to resolve its dynamic deps. Carried over from CV_demo.
ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    YOLO_CONFIG_DIR=/wise-edge/advantech-yolo/.config/Ultralytics \
    YOLO_AUTOINSTALL=false

# X11 client libs for cv2.imshow(); runtime values are injected via compose.
# libcanberra-gtk* are not optional decoration: without them every cv2.imshow()
# logs "Failed to load module canberra-gtk-module" twice per window, which buries
# the real inference output in an operator's terminal.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libx11-6 \
        libxext6 \
        x11-utils \
        libcanberra-gtk-module \
        libcanberra-gtk3-module \
  && rm -rf /var/lib/apt/lists/*

# --- Heavy / rarely-changing layers first so editing src/ does not re-trigger
#     the apt layer on every rebuild. ---

# Demo video asset — small, rarely changes.
COPY data/test.mp4  data/test.mp4

RUN mkdir -p /wise-edge/advantech-yolo/output \
             /wise-edge/advantech-yolo/.config/Ultralytics

# Entrypoint before source: it changes far less often than the demo code.
COPY entrypoint.jp7.sh  entrypoint.sh
RUN chmod +x entrypoint.sh

# Application source LAST among the shared layers, so iterating on it rebuilds
# only the tail of the image.
COPY src/advantech-yolo.py  src/advantech-yolo.py

# Hydration is fail-safe: the container stays up even if it fails, so the
# operator keeps a shell to diagnose with.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD test -f /wise-edge/advantech-yolo/.ready || exit 1

ENTRYPOINT ["/wise-edge/advantech-yolo/entrypoint.sh"]

# ==============================================================================
# ---------------------------- DIVERGENCE MARKER -------------------------------
# Everything ABOVE is identical across the three images and is therefore stored
# once. Everything BELOW is per-task and costs ~6 MB per image. Keep it that
# way: an ARG referenced above this line would fork the whole image.
# ==============================================================================
ARG YOLO_TASK=detect
ARG YOLO_WEIGHTS=yolo11n.pt

# Only this task's weights. Baked in so the image runs offline with no
# ultralytics assets fetch, and reproducibly from models/.
COPY models/${YOLO_WEIGHTS}  models/${YOLO_WEIGHTS}

# Promote the build args to runtime env so the CMD below -- and anyone who
# execs into the container -- can see what this image is for.
ENV YOLO_TASK=${YOLO_TASK} \
    YOLO_MODEL=models/${YOLO_WEIGHTS}

LABEL com.advantech.task="${YOLO_TASK}" \
      com.advantech.weights="${YOLO_WEIGHTS}"

# Default: run THIS image's task on the bundled demo video, annotated output
# under output/<task>/. --iou is deliberately absent: the app defaults it to
# 0.45 and applies it to detect and segment only, so one CMD serves all three.
# Shell form because the args come from ENV; entrypoint.sh execs "$@".
CMD ["bash", "-lc", \
     "exec python3 src/advantech-yolo.py \
        --task \"$YOLO_TASK\" --model \"$YOLO_MODEL\" \
        --input data/test.mp4 --conf 0.25 --device 0 \
        --save --save-dir \"/wise-edge/advantech-yolo/output/$YOLO_TASK\""]
