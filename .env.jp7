# ==============================================================================
# Advantech YOLO Vision (JetPack 7 / Thor) — Static Configuration
# Dynamic values (DISPLAY, XAUTHORITY, X11_SOCKET) are detected at runtime by
# build.jp7.sh. Modelled on CV_demo/Object-counting/.env.
#
# Usage:  docker compose -f docker-compose.jp7.yml --env-file .env.jp7 up -d
#         (or just: ./build.jp7.sh)
# ==============================================================================

# ── Image ─────────────────────────────────────────────────────────────────────
# Built locally by build.jp7.sh from Dockerfile.jp7. Retag and push to harbor
# once validated on the target.
YOLO_JP7_IMAGE=advantech-yolo-vision:jp7-demo

# ── Container Identity ────────────────────────────────────────────────────────
CONTAINER_NAME=advantech-yolo-jp7
SERVICE_NAME=advantech-yolo

# ── NVIDIA Runtime ────────────────────────────────────────────────────────────
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,video,utility,graphics,display

# ── CUDA / Library Paths ──────────────────────────────────────────────────────
LD_LIBRARY_PATH=/usr/local/lib:/usr/local/cuda/lib64:/usr/lib/aarch64-linux-gnu/tegra

# ── Qt / GUI Stability ────────────────────────────────────────────────────────
QT_X11_NO_MITSHM=1
NO_AT_SPI=1
DBUS_SESSION_BUS_ADDRESS=/dev/null

# ── EULA ──────────────────────────────────────────────────────────────────────
# Ultralytics is BYOL. Set to `true` once you have read and accepted the
# Ultralytics licence; without it entrypoint.jp7.sh will not install it and the
# demo cannot run.
ACCEPT_ULTRALYTICS_EULA=false

# ── BYOL Packages ─────────────────────────────────────────────────────────────
# Ultralytics installs at runtime into a named volume, so it is downloaded once
# per device instead of on every container launch.
# Purge the volume with: ./build.jp7.sh --clean
BYOL_VOLUME=advantech-yolo-jp7-byol
ULTRALYTICS_VERSION=8.4.24
ULTRALYTICS_THOP_VERSION=2.0.18

# ── Demo Defaults (consumed by build.jp7.sh when it launches the demo) ────────
YOLO_TASK=detect
YOLO_MODEL=models/yolo11n.pt
YOLO_INPUT=data/test.mp4
YOLO_CONF=0.25
YOLO_DEVICE=0

# ── Hydration ─────────────────────────────────────────────────────────────────
# Seconds build.jp7.sh waits for first-run hydration (apt + BYOL install).
# Cold runs on slow links legitimately exceed 60s; subsequent runs are instant.
HYDRATION_TIMEOUT=300

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_MAX_SIZE=20m
LOG_MAX_FILE=3
